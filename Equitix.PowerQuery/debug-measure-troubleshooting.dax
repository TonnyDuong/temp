Debug Subcontractor Actual 2025 =
CALCULATE(
    SUM('_Cost_Subcontractor_Actuals'[Amount]),
    FILTER(
        ALL('_Cost_Subcontractor_Actuals'[Date]),
        YEAR('_Cost_Subcontractor_Actuals'[Date]) = 2025
    )
)

Debug Subcontractor Actual 2025 Screenshot Target =
-217158.69

Debug Subcontractor Actual 2025 Screenshot Variance =
[Debug Subcontractor Actual 2025] - [Debug Subcontractor Actual 2025 Screenshot Target]

Debug Subcontractor Actual 2026 =
CALCULATE(
    SUM('_Cost_Subcontractor_Actuals'[Amount]),
    FILTER(
        ALL('_Cost_Subcontractor_Actuals'[Date]),
        YEAR('_Cost_Subcontractor_Actuals'[Date]) = 2026
    )
)

Debug Subcontractor Actual 2026 Screenshot Target =
-243536.16

Debug Subcontractor Actual 2026 Screenshot Variance =
[Debug Subcontractor Actual 2026] - [Debug Subcontractor Actual 2026 Screenshot Target]

Debug Subcontractor Actual 2026 Sector Sum =
SUMX(
    VALUES(dim_Project_Live[Sector]),
    CALCULATE([Debug Subcontractor Actual 2026])
)

Debug Subcontractor Actual 2026 Sector Sum Difference =
[Debug Subcontractor Actual 2026 Sector Sum] - [Debug Subcontractor Actual 2026]


