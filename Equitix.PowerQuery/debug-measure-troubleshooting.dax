// =====================================================================
// Revenue fact checks
// These help confirm whether the revenue issue is the same kind of
// selected-year/date-context problem.
// =====================================================================

Debug Revenue Raw =
SUM(fact_Revenue_Live[Amount])

Debug Revenue Actual Raw =
CALCULATE(
    SUM(fact_Revenue_Live[Amount]),
    fact_Revenue_Live[Type] = "Actual"
)

Debug Revenue Forecast Raw =
CALCULATE(
    SUM(fact_Revenue_Live[Amount]),
    fact_Revenue_Live[Type] = "Forecast"
)

Debug Revenue Selected Year =
VAR SelectedYear =
    SELECTEDVALUE('Reporting Year'[Year])
RETURN
CALCULATE(
    SUM(fact_Revenue_Live[Amount]),
    FILTER(
        ALL(dim_Date_Live[Date]),
        YEAR(dim_Date_Live[Date]) = SelectedYear
    )
)

Debug Revenue Rows Raw =
COUNTROWS(fact_Revenue_Live)

Debug Revenue Rows Selected Year =
VAR SelectedYear =
    SELECTEDVALUE('Reporting Year'[Year])
RETURN
CALCULATE(
    COUNTROWS(fact_Revenue_Live),
    FILTER(
        ALL(dim_Date_Live[Date]),
        YEAR(dim_Date_Live[Date]) = SelectedYear
    )
)

Debug Revenue Min Date =
MIN(fact_Revenue_Live[Date])

Debug Revenue Max Date =
MAX(fact_Revenue_Live[Date])

Debug Revenue Years =
VAR Years =
    DISTINCT(
        SELECTCOLUMNS(
            ALL(fact_Revenue_Live[Date]),
            "Year", YEAR(fact_Revenue_Live[Date])
        )
    )
RETURN
CONCATENATEX(Years, [Year], ", ", [Year], ASC)
