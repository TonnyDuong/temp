// =====================================================================
// Measure Troubleshooting Debug Measures
// ---------------------------------------------------------------------
// Purpose:
//   Temporary DAX patterns for comparing trusted implicit Sum(Amount)
//   visual columns against explicit measures, selected-year filtering,
//   row counts, and date coverage.
//
// Usage:
//   1. Copy only the section relevant to the table or measure being tested.
//   2. Add the Reporting Year table only if testing disconnected year logic.
//   3. Place the original implicit Sum(Amount) beside the matching Raw,
//      Selected Year, Difference, and Rows measures in the same visual.
//   4. Remove or hide these measures after diagnosis.
//
// Expected interpretation:
//   - Original implicit Sum(Amount) should match the matching Raw measure.
//   - Any difference between Raw and Selected Year is caused by date/year
//     filtering, not by a change of source table.
//   - Do not add cutoff-date logic in DAX for the existing actual/forecast
//     helper tables. Cutoff is already applied in Power Query using
//     _CutoverDate.
// =====================================================================


// =====================================================================
// Calculated table
// Create with Modeling -> New table.
// Keep disconnected. Do not relate this table to dim_Date_Live.
// =====================================================================

Reporting Year =
SELECTCOLUMNS(
    FILTER(
        VALUES(dim_Date_Live[Year]),
        dim_Date_Live[Year] IN { 2025, 2026, 2027 }
    ),
    "Year", dim_Date_Live[Year]
)


// =====================================================================
// Shared debug measure
// =====================================================================

Debug Selected Reporting Year =
SELECTEDVALUE('Reporting Year'[Year], -1)


// =====================================================================
// _Cost_Staff_Actuals
// =====================================================================

Debug Staff Actual Raw =
SUM('_Cost_Staff_Actuals'[Amount])

Debug Staff Actual Selected Year =
VAR SelectedYear =
    SELECTEDVALUE('Reporting Year'[Year])
RETURN
CALCULATE(
    SUM('_Cost_Staff_Actuals'[Amount]),
    FILTER(
        ALL('_Cost_Staff_Actuals'[Date]),
        YEAR('_Cost_Staff_Actuals'[Date]) = SelectedYear
    )
)

Debug Staff Actual Difference =
[Debug Staff Actual Raw] - [Debug Staff Actual Selected Year]

Debug Staff Actual Rows Raw =
COUNTROWS('_Cost_Staff_Actuals')

Debug Staff Actual Rows Selected Year =
VAR SelectedYear =
    SELECTEDVALUE('Reporting Year'[Year])
RETURN
CALCULATE(
    COUNTROWS('_Cost_Staff_Actuals'),
    FILTER(
        ALL('_Cost_Staff_Actuals'[Date]),
        YEAR('_Cost_Staff_Actuals'[Date]) = SelectedYear
    )
)

Debug Staff Actual Min Date =
MIN('_Cost_Staff_Actuals'[Date])

Debug Staff Actual Max Date =
MAX('_Cost_Staff_Actuals'[Date])

Debug Staff Actual Years =
VAR Years =
    DISTINCT(
        SELECTCOLUMNS(
            ALL('_Cost_Staff_Actuals'[Date]),
            "Year", YEAR('_Cost_Staff_Actuals'[Date])
        )
    )
RETURN
CONCATENATEX(Years, [Year], ", ", [Year], ASC)


