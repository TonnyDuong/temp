table dim_ForecastSnapshot_Live
	lineageTag: 00a06481-cc28-48f9-b22f-0132bb0dd27d

	column SnapshotDate
		dataType: dateTime
		formatString: Long Date
		lineageTag: ddcd8c8c-298c-40e4-a9be-bc8dde1a8ba8
		summarizeBy: none
		sourceColumn: SnapshotDate

		variation Variation
			isDefault
			relationship: be642444-bfa7-4e11-85d3-5f6f4fd94c01
			defaultHierarchy: LocalDateTable_8ef9692d-5881-43c5-93c1-bcf9c67d660e.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column SnapshotName
		dataType: string
		lineageTag: 1c956220-37cd-40c4-8703-aaf6e5063fa3
		summarizeBy: none
		sourceColumn: SnapshotName

		annotation SummarizationSetBy = Automatic

	partition dim_ForecastSnapshot_Live = m
		mode: import
		source =
				// =====================================================================
				// dim_ForecastSnapshot_Live
				// ---------------------------------------------------------------------
				// Purpose:      Lookup table for forecast snapshot dates. Joined to
				//               fact_Revenue_Live and fact_Cost_Live for the "as-at"
				//               filter on the forecast table.
				// Grain:        One row per snapshot date.
				// Dependencies: none (manually maintained).
				// Load:         enabled.
				// ---------------------------------------------------------------------
				// Add a new row every time a new dated forecast snapshot arrives. The
				// SnapshotDate must exactly match the date stamped on the corresponding
				// rows in fact_Revenue_Live and fact_Cost_Live.
				// =====================================================================
				let
				    SnapshotList = #table(
				        type table [SnapshotDate = date, SnapshotName = text],
				        {
				            {#date(2025, 12, 31), "31Dec2025"}
				            // Append more rows here as new snapshots are delivered, e.g.
				            // ,{#date(2026, 3, 31), "31Mar2026"}
				        }
				    )
				in
				    SnapshotList

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

